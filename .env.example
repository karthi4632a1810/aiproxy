# AI Proxy Configuration
PORT=3000
DEFAULT_MODEL=claude-opus-5.5
DEFAULT_THINKING=true
DEFAULT_DEEP_SEARCH=true
UPSTREAM_URL=https://freemodels-chat.freemodels.workers.dev

# Workspace coding agent (defaults to the directory containing server.js)
HOST=127.0.0.1
AGENT_ENABLED=true
# WORKSPACE_ROOT=/absolute/path/to/project
# Optional persistent key; required for remote agent access. Without it the
# local dashboard obtains a temporary token from /api/agent/session.
# AGENT_API_KEY=replace-with-a-long-random-secret
# prompt works with text-only FreeModels workers; native requires tool support.
TOOL_CALL_MODE=prompt
UPSTREAM_TIMEOUT_MS=120000
