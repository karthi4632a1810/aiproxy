# AI Proxy Configuration
PORT=3000
DEFAULT_MODEL=claude-opus-5.5
DEFAULT_THINKING=true
DEFAULT_DEEP_SEARCH=true
UPSTREAM_URL=https://freemodels-chat.freemodels.workers.dev

# Workspace coding agent (defaults to the directory containing server.js)
HOST=127.0.0.1
AGENT_ENABLED=true
# WORKSPACE_ROOT=/absolute/path/to/project
# Login, keys and usage persist here. Use a persistent disk for hosted deployments.
# DATA_DIR=/absolute/path/to/persistent/aiproxy-data
# Set this to the exact public HTTPS origin when hosting behind a reverse proxy.
# APP_ORIGIN=https://proxy.example.com
# Set a long random setup token before exposing a fresh server remotely.
# SETUP_TOKEN=replace-with-a-long-random-secret
# Only trust the actual reverse proxy addresses, for accurate client IPs.
# TRUST_PROXY=loopback
# Create named API keys in the dashboard. AGENT_API_KEY is no longer used.
# prompt works with text-only FreeModels workers; native requires tool support.
TOOL_CALL_MODE=prompt
UPSTREAM_TIMEOUT_MS=120000
